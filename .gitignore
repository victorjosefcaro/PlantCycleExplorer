# Ignore Visual Studio temporary files, build results, and
# user-specific files
.vs/
*.user
*.suo
*.userosscache
*.sln.docstates

# Ignore build results
bin/
obj/
Debug/
Release/

# Ignore NuGet packages
*.nupkg
packages/
project.lock.json
project.fragment.lock.json
*.nuget.props
*.nuget.targets

# Ignore files generated by popular Visual Studio add-ons
*.resharper
_ReSharper*/
*.DotSettings.user
*.DotSettings

# Ignore files for Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Ignore files for macOS
.DS_Store
.AppleDouble
.LSOverride

# Ignore files for Linux
*~

# Ignore logs and database files
*.log
*.ldf
*.mdf

# Ignore publish output
publish/

# Ignore application insights
ApplicationInsights.config
ApplicationInsightsTelemetry.config

# Ignore Rider IDE files
.idea/

# Ignore JetBrains Rider project files
.idea/
*.iml
